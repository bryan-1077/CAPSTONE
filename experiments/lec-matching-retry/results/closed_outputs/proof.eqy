[gate]
read_rtlil "/mnt/nfs-scratch/ECEN_403-404/ddr4_capstone/CAPSTONE/shared/allocations/733265/lec_runs/356dc9917c74489c94a97b3ca5358e24/verification_reports/agent4_runs/2026-11-03_23-50-08_ts9t2jq0/agent4/eqy_work/gate.il"

[match ddr4_controller_top]
gold-match clk clk
gold-match rst_n rst_n
gold-match txn_valid txn_valid
gold-match txn_is_write txn_is_write
gold-match txn_addr txn_addr
gold-match txn_wdata txn_wdata
gold-match txn_bank txn_bank
gold-match txn_ready txn_ready
gold-match cmd_ready cmd_ready
gold-match rsp_valid rsp_valid
gold-match rsp_rdata rsp_rdata
gold-nomatch *
gate-nomatch *

[collect ddr4_controller_top]
bind *
group *

[strategy prove]
use sby
engine abc pdr
depth 20
timeout 600
