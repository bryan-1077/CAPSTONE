# Python runtime artifacts
__pycache__/
*.py[cod]

# Keep experimental validation sources; exclude other server checkout files.
/server/*
!/server/validation/

# Local credentials and environment settings
.env
.env.*

# Flow/runtime logs
*.log
shared/mailbox/

# Simulator and waveform artifacts
obj_dir/
*.vcd
*.fst
*.vvp

# LLM/generated repair scratch space
.llm_cache/
local/frontend/microarch/builds/
local/frontend/rtl_output/
debug/failures/*
!debug/failures/.gitkeep
